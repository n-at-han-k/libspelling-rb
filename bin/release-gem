#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the Apache License, Version 2.0.
# Copyright, 2026, by General Intelligence Systems.

# RELEASE-GEM(1)                General Commands Manual             RELEASE-GEM(1)
#
# NAME
#      bin/release-gem — build and publish this version, and tag it
#
# SYNOPSIS
#      bin/release-gem
#
# DESCRIPTION
#      One version, one gem.  This gem is pure Ruby -- the binding is
#      GObjectIntrospection::Loader reading Spelling-1.typelib at require time --
#      so there are no precompiled per-platform gems to collect, and nothing
#      here waits on a cross-compile workflow.  That workflow, and the script
#      that downloaded its artefacts, went with the Rust extension.
#
#      The one guard worth keeping is the version check: a pushed version
#      cannot be taken back, so the local version has to be ahead of what is
#      already on RubyGems.
#
#      A gem which is already published is skipped rather than failed, so a
#      release which died part way through can be run again.
#
#      It is not `gem kit release`, whose gates -- a changelog entry for this
#      version, no due deprecation deadline, a clean working tree -- this
#      skips.  Run `gem kit release --dry-run` first to get them.
#
# EXIT STATUS
#      The bin/release-gem utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/test(1), gem(1)
#
# libspelling                   November 3, 2026                 RELEASE-GEM(1)

require_relative "../lib/libspelling/version"
require "open3"

local_version = Libspelling::VERSION
gem_name = "libspelling"
gemspec = "libspelling.gemspec"

puts "Local version: #{local_version}"

remote_output = `gem specification #{gem_name} version --remote 2>&1`

if $?.success?
  remote_version = remote_output[/version: (.+)/, 1]&.strip
  puts "Remote version: #{remote_version}"

  if Gem::Version.new(local_version) <= Gem::Version.new(remote_version)
    abort "ERROR: Local version (#{local_version}) has not been incremented past remote (#{remote_version})"
  end
else
  puts "Gem not yet published remotely, proceeding with first release"
end

puts "\nBuilding #{gem_name} #{local_version} from #{gemspec}..."

system("gem build #{gemspec}") || abort("ERROR: gem build failed")

gem_file = "#{gem_name}-#{local_version}.gem"

puts "\nPushing #{gem_file}..."

out, status = Open3.capture2e("gem", "push", gem_file)

print out

unless status.success?
  if out.include?("has already been pushed")
    puts "  (already published — skipping)"
  else
    abort "ERROR: gem push failed for #{gem_file}"
  end
end

puts "\nReleased #{gem_name} #{local_version}"

tag = "v#{local_version}"

system("git", "tag", "-a", tag, "-m", "Release #{local_version}")
system("git", "push", "origin", tag)
